
.search {
  color: $color-inner;
  padding: 0 15px;
  height: 100%;
  line-height: 60px;
  cursor: pointer;
  transition: background-color 0.3s;
  &:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }
}
.message-box_wrapper {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  z-index: 11;
  .message-box {
    display: flex;
    flex-direction: column;
    width: 36rem;
    height: 70%;
    padding: 10px 20px;
    margin-top: 100px;
    background-color: #fff;
    h2 {
      font-size: 1.5rem;
    }
    .close {
      cursor: pointer;
      &:hover {
        color: $color-primary;
      }
    }
    #local-search-input {
      position: relative;
      width: 100%;
      display: block;
      // outline: none;
      // border: 0px;
      // color: #76838f;
      background-color: transparent;
      // background-repeat: no-repeat;
      // background-image: linear-gradient(#ccc, #ccc, #ccc, #ccc),
      //                   linear-gradient(#e4eaec, #e4eaec);
      // background-position: center bottom, center calc(100% - 1px);
      // background-size: 0 2px, 100% 1px;
      // padding: 0.6em 0;
      // padding-right: 20px;
      // 注释代码是另一种输入框样式
      box-sizing: border-box;
      font-size: 1rem;
      z-index: 2;

      padding: .25rem .7rem;
      outline: 0;
      border: 2px solid $color-primary;
      border-radius: 2rem;
      font-size: 14px;
      margin-top: 15px;
    }
    #local-search-input:focus {
      // transition-duration: 0.3s;
      // background-size: 100% 2px, 100% 1px;
      // background-image: linear-gradient($color-primary, $color-primary),
      //                 linear-gradient(#e4eaec, #e4eaec);
      // 注释代码是另一种输入框样式
    }
  }
  .result-wrapper {
    height: 80%;
    overflow: auto;
    overflow-x: hidden;
    margin-top: 10px;
    .search-keyword {
      color: #d63200;
    }
    a {
      // text-decoration: none;
    }
    p {
      font-size: 0.9rem;
      line-height: 1.5rem;
      color: rgba(0, 0, 0, 0.5);
    }
    ul {
      list-style-type none;
      box-sizing: border-box;
      padding: 10px 4px 4px;
      li {
        padding: 0;
        border-radius: 12px;
        margin-bottom: 12px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
        background: #fff;
        transition: all .22s ease;
        &:hover {
          border-color: $color-primary;
          box-shadow: 0 8px 18px rgba(0, 0, 0, .1);
          transform: translateY(-1px);
          .search-result-go {
            opacity: 1;
            transform: translateX(0);
          }
        }
        a.search-result-item {
          display: block;
          position: relative;
          padding: 14px 18px 12px;
          color: inherit;
          text-decoration: none;
          cursor: pointer !important;
          * {
            cursor: pointer !important;
          }
          .search-result-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
          }
          .search-result-title {
            font-size: 1.05rem;
            font-weight: 600;
            line-height: 1.4;
            color: #222;
          }
          .search-result-go {
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: $color-primary;
            opacity: 0;
            transform: translateX(6px);
            transition: all .22s ease;
            font-size: 13px;
          }
          .search-result-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 8px 0 6px;
          }
          .search-result-tag {
            display: inline-block;
            padding: 1px 8px;
            border-radius: 999px;
            font-size: 12px;
            line-height: 1.6;
            color: $color-primary;
            background: rgba($color-primary, 0.1);
          }
          .search-result-excerpt {
            margin: 0 0 4px;
            font-size: 0.92rem;
            color: rgba(0, 0, 0, 0.72);
          }
          .search-result-content {
            margin: 0;
            font-size: 0.84rem;
            line-height: 1.45;
            color: rgba(0, 0, 0, 0.45);
          }
        }
      }
    }
  }
}
@media (max-width: 551px) {
  .message-box_wrapper {
    .message-box {
      width: 80%;
    }
  }
}
