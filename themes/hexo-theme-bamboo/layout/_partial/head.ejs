    <% } %>
    <meta property="og:type" content="article"/>
    <% if (page.swiper){ %>
        <meta property="og:image" content="<%= page.swiper %>"/>
    <% } else if (config.swiper){ %>
        <meta property="og:image" content="<%= config.swiper %>"/>
    <% } %>
    <% if (page.date){ %>
