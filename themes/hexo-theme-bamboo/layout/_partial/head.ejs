    <% } else if (config.date){ %>
        <meta property="og:release_date" content="<%= config.date %>"/>
    <% } %>
    <% if (page.title){ %>
        <meta property="og:title" content="<%= page.title %>"/>
    <% } else if (config.title){ %>
