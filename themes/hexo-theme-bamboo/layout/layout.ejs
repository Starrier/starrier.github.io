<!DOCTYPE html>
<html>
  <%- partial('_partial/head') %>
  <body>
    <script>
      (function () {
        try {
          var isDark = JSON.parse(localStorage.getItem('dark'));
          if (isDark === null) {
            isDark = JSON.parse('<%= theme.dark.default %>');
          }
          if (isDark) {
            document.body.classList.add('darkModel');
          }
        } catch (e) {}
      })();
    </script>
    <script src="<%- url_for('/js/jquery3.5.1.js') %>"></script>
    <script src="<%- url_for('/js/vue2.6.11.js') %>"></script>
    <script>
      window.__bambooCanDecorate = function () {
        return window.matchMedia('(pointer: fine)').matches
          && window.matchMedia('(min-width: 769px)').matches
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      };
      window.__bambooLoadScript = function (src, onload) {
        var s = document.createElement('script');
        s.src = src;
        if (onload) s.onload = onload;
        document.body.appendChild(s);
      };
    </script>

    <%- partial('_partial/header') %>
    <div class="bg-floor" style="position: fixed;left: 0;top: 0;width: 100%;height: 100%;z-index: -2;"></div>
    <main class="main" style="<% if(theme.headMenuFixed) { %>margin-top: 60px;<% } %>">
      <%- body %>
    </main>
    <%- partial('_partial/footer') %>

    <% if(theme.goTop.on === true ) { %>
      <%- partial('_partial/goTop') %>
    <% } %>

    <% if(theme.music.on === true ) { %>
      <%- partial('_partial/aplayer') %>
    <% } %>

    <% if(theme.fancybox.on === true && is_post()) { %>
      <script src="<%- url_for('/js/fancybox/jquery.fancybox.min.js') %>" defer></script>
      <script src="<%- url_for('/js/wrapImage.js') %>" defer></script>
    <% } %>

    <% if(theme.cursor_effect.on === true) { %>
      <script>
        if (window.__bambooCanDecorate()) {
          <% if(theme.cursor_effect.type === "fireworks") { %>
            window.__bambooLoadScript('<%- url_for('/js/cursor/fireworks.js') %>');
          <% } else if(theme.cursor_effect.type === "explosion") { %>
            var canvas = document.createElement('canvas');
            canvas.className = 'fireworks';
            canvas.setAttribute('style', 'position: fixed;left: 0;top: 0;z-index: 999; pointer-events: none;');
            document.body.appendChild(canvas);
            window.__bambooLoadScript('<%- url_for('/js/anime.min.js') %>', function () {
              window.__bambooLoadScript('<%- url_for('/js/cursor/explosion.min.js') %>');
            });
          <% } else if(theme.cursor_effect.type === "love") { %>
            window.__bambooLoadScript('<%- url_for('/js/cursor/clicklove.js') %>');
          <% } else if(theme.cursor_effect.type === "text") { %>
            window.__bambooLoadScript('<%- url_for('/js/cursor/text.js') %>');
          <% } %>
        }
      </script>
    <% } %>

    <%- partial('_partial/baidu-push') %>

    <script>
      if (window.__bambooCanDecorate()) {
        window.__bambooLoadScript('<%- url_for('/js/ribbon.min.js') %>');
      }
    </script>
    <% if(theme.aos.on === true ) { %>
      <script src="<%- url_for('/js/aos/aos.js') %>"></script>
      <script>
        var themeOffset = parseInt('<%= theme.aos.offset %>') || 120;
        var themeDelay = parseInt('<%= theme.aos.delay %>')|| 0;
        var themeDuration = parseInt('<%= theme.aos.duration %>') || 400;
        var themeEasing = '<%= theme.aos.easing %>' || 'ease';
        var themeOnce = eval('<%= theme.aos.once %>') || false;
        var themeMirror = eval('<%= theme.aos.mirror %>') || false;
        var themeAnchorPlacement = '<%= theme.aos.anchorPlacement %>' || 'top-bottom';
        AOS.init({
          disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
          startEvent: 'DOMContentLoaded',
          initClassName: 'aos-init',
          animatedClassName: 'aos-animate',
          useClassNames: false,
          disableMutationObserver: false,
          debounceDelay: 50,
          throttleDelay: 99,
          offset: themeOffset,
          delay: themeDelay,
          duration: themeDuration,
          easing: themeEasing,
          once: themeOnce,
          mirror: themeMirror,
          anchorPlacement: themeAnchorPlacement,
        });
      </script>
    <% } %>

    <% if (theme.copy.on){ %>
      <%- partial('_partial/copy') %>
    <% } %>

    <% if (theme.inputEffects.on){ %>
      <script>
        if (window.__bambooCanDecorate()) {
          window.__bambooLoadScript('<%- url_for('/js/activate-power-mode.js') %>', function () {
            POWERMODE.colorful = true;
            POWERMODE.shake = false;
            document.body.addEventListener('input', POWERMODE);
          });
        }
      </script>
    <% } %>

    <% if (is_post()) { %>
    <script src="<%- url_for('/js/clipboard/clipboard.min.js') %>"></script>
    <script>
      !function (e, t, a) {
        var copy = '<%= __("copy") %>';
        var initCopyCode = function(){
          var copyHtml = '';
          copyHtml += '<button class="btn-copy" data-clipboard-snippet="" style="position:absolute;top:0;right:0;z-index:1;">';
          copyHtml += '<i class="fa fa-copy"></i><span>' + copy + '</span>';
          copyHtml += '</button>';
          $(".post-detail pre").wrap("<div class='codeBox' style='position:relative;width:100%;'></div>")
          $(".post-detail pre").before(copyHtml);
          new ClipboardJS('.btn-copy', {
              target: function(trigger) {
                  return trigger.nextElementSibling;
              }
          });
        }
        initCopyCode();
      }(window, document);
    </script>
    <% } %>
    <script src="<%- url_for('/js/lazyload/lazyload@1.9.1.js') %>"></script>
    <script>
      $(function() {
        $("div.lazyload, img.lazyload, a.lazyload").lazyload({
            effect: "fadeIn",
            threshold: 200,
            placeholder: "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        });
    });
    </script>
    <script async src="https://jspassport.ssl.qhimg.com/11.0.1.js?d182b3f28525f2db83acfaaf6e696dba" id="sozz"></script>
  </body>
</html>
